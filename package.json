{
  "name": "flux-ui",
  "version": "0.1.24",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @flux-ui/docs dev",
    "generate": "node scripts/generate-icons.mjs && node scripts/generate-brand.mjs && node scripts/generate-components.mjs",
    "generate:check": "node tooling/terminal/cli.mjs generate:check",
    "component:new": "node scripts/new-component.mjs",
    "component:doctor": "node scripts/component-doctor.mjs",
    "clean": "node scripts/clean.mjs .cache && node scripts/clean.mjs packages/react/dist && node scripts/clean.mjs packages/tokens/dist && node scripts/clean.mjs packages/icons/dist && node scripts/clean.mjs packages/identity/dist && node scripts/clean.mjs apps/docs/dist && node scripts/clean.mjs apps/storybook/dist",
    "build": "node tooling/terminal/cli.mjs build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --cache --cache-location .cache/eslint --max-warnings=0",
    "lint:fix": "eslint . --cache --cache-location .cache/eslint --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --include files,dependencies,unlisted,binaries,unresolved --use-tsconfig-files",
    "test": "node tooling/terminal/cli.mjs test",
    "test:e2e": "node tooling/terminal/cli.mjs test:e2e",
    "test:a11y": "pnpm --filter @flux-ui/docs test:a11y",
    "bench": "pnpm --filter @flux-ui/react bench",
    "size": "node tooling/terminal/cli.mjs size",
    "bible:check": "node scripts/run-coding-bible.mjs check .",
    "bible:staged": "node scripts/run-coding-bible.mjs check . --staged",
    "bible:refresh": "pnpm update -w @coding-bible/analyzer",
    "bible:pin": "node scripts/pin-coding-bible.mjs",
    "check": "node tooling/terminal/cli.mjs check",
    "check:full": "node tooling/terminal/cli.mjs check:full",
    "check:fix": "pnpm generate && pnpm build:packages && pnpm lint:fix && pnpm format && pnpm generate && pnpm check",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release": "node tooling/release/instructions.mjs",
    "prepare": "husky",
    "bible:changed": "node scripts/run-coding-bible.mjs check . --changed",
    "size:changed": "node tooling/terminal/cli.mjs size:changed",
    "size:compare": "node tooling/size/compare.mjs",
    "size:baseline:review": "pnpm build:packages && node tooling/size/check.mjs --review-bundled-baseline",
    "size:update": "pnpm build:packages && node tooling/size/check.mjs --update-bundled-baseline",
    "size:release": "node tooling/terminal/cli.mjs size:release",
    "size:test": "node --test --test-reporter=./tooling/terminal/node-reporter.mjs tooling/size/*.test.mjs",
    "build:packages": "node tooling/terminal/cli.mjs build:packages",
    "storybook": "pnpm --filter @flux-ui/storybook dev",
    "storybook:build": "node tooling/terminal/cli.mjs storybook:build",
    "perf": "node tooling/terminal/cli.mjs perf",
    "perf:update": "node tooling/perf/check.mjs --update-baseline && pnpm generate",
    "perf:smoke": "node tooling/terminal/cli.mjs perf:smoke",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:test": "node --test --test-reporter=./tooling/terminal/node-reporter.mjs scripts/test/docs-catalog.test.mjs scripts/test/showcase*.test.mjs",
    "icons:size": "pnpm --filter @flux-ui/icons build && node tooling/icons/check.mjs",
    "icons:test": "node --test --test-reporter=./tooling/terminal/node-reporter.mjs tooling/icons/*.test.mjs",
    "icons:size:update": "pnpm --filter @flux-ui/icons build && node tooling/icons/check.mjs --update-baseline",
    "trust:test": "node --test --test-reporter=./tooling/terminal/node-reporter.mjs tooling/trust/*.test.mjs tooling/release/*.test.mjs tooling/verify/*.test.mjs tooling/terminal/*.test.mjs",
    "trust:quality": "node tooling/trust/run-checks.mjs quality",
    "trust:browser": "node tooling/trust/run-checks.mjs browser",
    "trust:generate": "node tooling/trust/generate.mjs",
    "release:pack": "node tooling/release/pack.mjs",
    "dogfood:check": "node tooling/dogfood/check.mjs",
    "dogfood:test": "node --test --test-reporter=./tooling/terminal/node-reporter.mjs tooling/dogfood/*.test.mjs",
    "archive": "node scripts/archive.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "consumer:packed": "node tooling/release/packed-consumer.mjs",
    "consumer:check": "node tooling/terminal/cli.mjs consumer:check",
    "safety:test": "node --test --test-reporter=./tooling/terminal/node-reporter.mjs tooling/safety/*.test.mjs",
    "feature:test": "node --test --test-reporter=./tooling/terminal/node-reporter.mjs tooling/features/*.test.mjs",
    "terminal:test": "node --test --test-reporter=./tooling/terminal/node-reporter.mjs tooling/terminal/*.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@coding-bible/analyzer": "github:Xanhast-pf/coding-bible#main&path:packages/analyzer",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,yaml,yml,css}": [
      "prettier --write"
    ]
  }
}
