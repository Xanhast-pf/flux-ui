{
  "name": "flux-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @flux-ui/docs dev",
    "generate": "node scripts/generate-components.mjs",
    "generate:check": "node scripts/generate-components.mjs --check",
    "component:new": "node scripts/new-component.mjs",
    "component:doctor": "node scripts/component-doctor.mjs",
    "clean": "node scripts/clean.mjs .cache && node scripts/clean.mjs packages/react/dist && node scripts/clean.mjs packages/tokens/dist && node scripts/clean.mjs apps/docs/dist",
    "build": "pnpm build:packages && pnpm --filter @flux-ui/docs build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --cache --cache-location .cache/eslint --max-warnings=0",
    "lint:fix": "eslint . --cache --cache-location .cache/eslint --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --include files,dependencies,unlisted,binaries,unresolved --use-tsconfig-files",
    "test": "pnpm -r --if-present test && pnpm size:test",
    "test:e2e": "pnpm --filter @flux-ui/docs test:e2e",
    "test:a11y": "pnpm --filter @flux-ui/docs test:a11y",
    "bench": "pnpm --filter @flux-ui/react bench",
    "size": "node tooling/size/check.mjs",
    "bible:check": "coding-bible check .",
    "bible:staged": "coding-bible check . --staged",
    "bible:pin": "node scripts/pin-coding-bible.mjs",
    "check": "pnpm generate:check && pnpm format && pnpm lint && pnpm typecheck && pnpm knip && pnpm test && pnpm build && pnpm size && pnpm bible:check",
    "check:full": "pnpm check && node tooling/size/check.mjs --release && pnpm test:e2e",
    "check:fix": "pnpm generate && pnpm lint:fix && pnpm format && pnpm check",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "husky",
    "bible:changed": "coding-bible check . --changed",
    "size:changed": "pnpm build:packages && node tooling/size/check.mjs --changed",
    "size:update": "pnpm build:packages && node tooling/size/check.mjs --update-baseline",
    "size:release": "pnpm build:packages && node tooling/size/check.mjs --release",
    "size:test": "node --test tooling/size/*.test.mjs",
    "build:packages": "pnpm --filter @flux-ui/tokens build && pnpm --filter @flux-ui/react build"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@coding-bible/analyzer": "github:Xanhast-pf/coding-bible#8291564770ca1cfc9c0701ba8548d3a0acdcd37a&path:packages/analyzer",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,yaml,yml,css}": [
      "prettier --write"
    ]
  }
}
