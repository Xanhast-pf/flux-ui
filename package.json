{
  "name": "flux-ui",
  "version": "0.1.15",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @flux-ui/docs dev",
    "generate": "node scripts/generate-icons.mjs && node scripts/generate-components.mjs",
    "generate:check": "node scripts/generate-icons.mjs --check && node scripts/generate-components.mjs --check",
    "component:new": "node scripts/new-component.mjs",
    "component:doctor": "node scripts/component-doctor.mjs",
    "clean": "node scripts/clean.mjs .cache && node scripts/clean.mjs packages/react/dist && node scripts/clean.mjs packages/tokens/dist && node scripts/clean.mjs packages/icons/dist && node scripts/clean.mjs packages/identity/dist && node scripts/clean.mjs apps/docs/dist && node scripts/clean.mjs apps/storybook/dist",
    "build": "pnpm build:packages && pnpm --filter @flux-ui/docs build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --cache --cache-location .cache/eslint --max-warnings=0",
    "lint:fix": "eslint . --cache --cache-location .cache/eslint --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --include files,dependencies,unlisted,binaries,unresolved --use-tsconfig-files",
    "test": "pnpm -r --if-present test && pnpm size:test && pnpm icons:test && pnpm docs:test && pnpm trust:test",
    "test:e2e": "pnpm --filter @flux-ui/docs test:e2e",
    "test:a11y": "pnpm --filter @flux-ui/docs test:a11y",
    "bench": "pnpm --filter @flux-ui/react bench",
    "size": "node tooling/size/check.mjs && pnpm icons:size",
    "bible:check": "node scripts/run-coding-bible.mjs check .",
    "bible:staged": "node scripts/run-coding-bible.mjs check . --staged",
    "bible:pin": "node scripts/pin-coding-bible.mjs",
    "check": "pnpm generate:check && pnpm docs:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test && pnpm build && pnpm size && pnpm bible:check",
    "check:full": "pnpm check && node tooling/size/check.mjs --release && pnpm storybook:build && pnpm test:e2e && pnpm perf:smoke",
    "check:fix": "pnpm generate && pnpm lint:fix && pnpm format && pnpm check",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release": "node tooling/release/instructions.mjs",
    "prepare": "husky",
    "bible:changed": "node scripts/run-coding-bible.mjs check . --changed",
    "size:changed": "pnpm build:packages && node tooling/size/check.mjs --changed && pnpm icons:size",
    "size:update": "pnpm build:packages && node tooling/size/check.mjs --update-baseline && pnpm icons:size:update && pnpm generate",
    "size:release": "pnpm build:packages && node tooling/size/check.mjs --release && pnpm icons:size",
    "size:test": "node --test tooling/size/*.test.mjs",
    "build:packages": "pnpm --filter @flux-ui/tokens build && pnpm --filter @flux-ui/icons build && pnpm --filter @flux-ui/identity build && pnpm --filter @flux-ui/react build",
    "storybook": "pnpm --filter @flux-ui/storybook dev",
    "storybook:build": "pnpm --filter @flux-ui/storybook build",
    "perf": "node tooling/perf/check.mjs",
    "perf:update": "node tooling/perf/check.mjs --update-baseline && pnpm generate",
    "perf:smoke": "node tooling/perf/check.mjs --smoke",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:test": "node --test scripts/test/docs-catalog.test.mjs scripts/test/showcase.test.mjs",
    "icons:size": "node tooling/icons/check.mjs",
    "icons:test": "node --test tooling/icons/*.test.mjs",
    "icons:size:update": "node tooling/icons/check.mjs --update-baseline",
    "trust:test": "node --test tooling/trust/*.test.mjs tooling/release/*.test.mjs",
    "trust:quality": "node tooling/trust/run-checks.mjs quality",
    "trust:browser": "node tooling/trust/run-checks.mjs browser",
    "trust:generate": "node tooling/trust/generate.mjs",
    "release:pack": "node tooling/release/pack.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@coding-bible/analyzer": "github:Xanhast-pf/coding-bible#801dd87920e99f63016636d39586fa1565c997d9&path:packages/analyzer",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,yaml,yml,css}": [
      "prettier --write"
    ]
  }
}
