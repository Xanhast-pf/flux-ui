{
  "name": "@varua/flux-ui",
  "version": "0.1.25",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "dependencies": {
    "@varua/icons": "workspace:^",
    "@varua/tokens": "workspace:^"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vanilla-extract/css": "catalog:",
    "@vanilla-extract/vite-plugin": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-lib-inject-css": "catalog:",
    "vitest": "catalog:",
    "@storybook/react-vite": "catalog:"
  },
  "scripts": {
    "build": "pnpm --filter @varua/tokens build && pnpm --filter @varua/icons build && pnpm run build:package",
    "build:package": "node ../../scripts/check-portable-paths.mjs && node ../../scripts/clean.mjs packages/react/dist && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vitest bench --run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xanhast-pf/flux-ui.git",
    "directory": "packages/react"
  },
  "homepage": "https://flux.varua.ca/",
  "bugs": {
    "url": "https://github.com/Xanhast-pf/flux-ui/issues"
  }
}
