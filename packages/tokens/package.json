{
  "name": "@flux-ui/tokens",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/theme.css",
    "src/presets.css",
    "src/reset.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css",
    "./presets.css": "./src/presets.css",
    "./reset.css": "./src/reset.css"
  },
  "scripts": {
    "build": "node ../../scripts/clean.mjs packages/tokens/dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xanhast-pf/flux-ui.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://xanhast-pf.github.io/flux-ui/",
  "bugs": {
    "url": "https://github.com/Xanhast-pf/flux-ui/issues"
  }
}
