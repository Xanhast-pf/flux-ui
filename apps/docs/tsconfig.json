{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "paths": {
      "@flux-ui/react": ["../../packages/react/src/index.ts"],
      "@flux-ui/tokens": ["../../packages/tokens/src/index.ts"],
      "@flux-ui/tokens/*": ["../../packages/tokens/src/*"],
      "@flux-ui/icons": ["../../packages/icons/src/index.ts"],
      "@flux-ui/icons/*": ["../../packages/icons/src/*.ts"],
      "@flux-ui/identity": ["../../packages/identity/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "playwright.config.ts",
    "tests/**/*.ts"
  ]
}
