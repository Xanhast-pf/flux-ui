{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "paths": {
      "@varua/flux-ui": ["../../packages/react/src/index.ts"],
      "@varua/tokens": ["../../packages/tokens/src/index.ts"],
      "@varua/tokens/*": ["../../packages/tokens/src/*"],
      "@varua/icons": ["../../packages/icons/src/index.ts"],
      "@varua/icons/*": ["../../packages/icons/src/*.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "playwright.config.ts",
    "tests/**/*.ts"
  ]
}
