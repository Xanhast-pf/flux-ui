{
  "dev": [["pnpm", "--filter", "@flux-ui/docs", "dev"]],
  "generate": [
    ["node", "scripts/generate-icons.mjs"],
    ["node", "scripts/generate-brand.mjs"],
    ["node", "scripts/generate-components.mjs"]
  ],
  "generate:check": [
    ["node", "scripts/generate-icons.mjs", "--check"],
    ["node", "scripts/generate-brand.mjs", "--check"],
    ["node", "scripts/generate-components.mjs", "--check"]
  ],
  "component:new": [["node", "scripts/new-component.mjs"]],
  "component:doctor": [["node", "scripts/component-doctor.mjs"]],
  "component:readiness": [["node", "scripts/component-readiness.mjs"]],
  "clean": [
    ["node", "scripts/clean.mjs", ".cache"],
    ["node", "scripts/clean.mjs", "packages/react/dist"],
    ["node", "scripts/clean.mjs", "packages/tokens/dist"],
    ["node", "scripts/clean.mjs", "packages/icons/dist"],
    ["node", "scripts/clean.mjs", "packages/identity/dist"],
    ["node", "scripts/clean.mjs", "apps/docs/dist"],
    ["node", "scripts/clean.mjs", "apps/storybook/dist"]
  ],
  "build": [
    ["node", "tooling/terminal/tasks.mjs", "build:packages"],
    ["node", "tooling/terminal/tasks.mjs", "build:docs"]
  ],
  "typecheck": [["pnpm", "-r", "--if-present", "typecheck"]],
  "lint": [
    [
      "pnpm",
      "exec",
      "eslint",
      ".",
      "--cache",
      "--cache-location",
      ".cache/eslint",
      "--max-warnings=0"
    ]
  ],
  "lint:fix": [
    [
      "pnpm",
      "exec",
      "eslint",
      ".",
      "--cache",
      "--cache-location",
      ".cache/eslint",
      "--fix",
      "--max-warnings=0"
    ]
  ],
  "format": [["pnpm", "exec", "prettier", "--write", "."]],
  "format:check": [["pnpm", "exec", "prettier", "--check", "."]],
  "knip": [
    [
      "pnpm",
      "exec",
      "knip",
      "--include",
      "files,dependencies,unlisted,binaries,unresolved",
      "--use-tsconfig-files"
    ]
  ],
  "test": [
    [
      "pnpm",
      "-r",
      "--if-present",
      "test",
      "--reporter=default",
      "--reporter=../../tooling/terminal/vitest-reporter.mjs"
    ],
    ["node", "tooling/terminal/tasks.mjs", "size:test"],
    ["node", "tooling/terminal/tasks.mjs", "icons:test"],
    ["node", "tooling/terminal/tasks.mjs", "docs:test"],
    ["node", "tooling/terminal/tasks.mjs", "trust:test"],
    ["node", "tooling/terminal/tasks.mjs", "dogfood:test"],
    ["node", "tooling/terminal/tasks.mjs", "safety:test"],
    ["node", "tooling/terminal/tasks.mjs", "feature:test"]
  ],
  "test:e2e": [["pnpm", "--filter", "@flux-ui/docs", "test:e2e"]],
  "test:a11y": [["pnpm", "--filter", "@flux-ui/docs", "test:a11y"]],
  "bench": [["pnpm", "--filter", "@flux-ui/react", "bench"]],
  "size": [
    ["node", "tooling/size/check.mjs"],
    ["node", "tooling/terminal/tasks.mjs", "icons:size"]
  ],
  "bible:check": [["node", "scripts/run-coding-bible.mjs", "check", "."]],
  "bible:staged": [
    ["node", "scripts/run-coding-bible.mjs", "check", ".", "--staged"]
  ],
  "bible:refresh": [["pnpm", "update", "-w", "@coding-bible/analyzer"]],
  "bible:pin": [["node", "scripts/pin-coding-bible.mjs"]],
  "check": [
    ["node", "tooling/terminal/tasks.mjs", "generate:check"],
    ["node", "tooling/terminal/tasks.mjs", "drift:check"],
    ["node", "tooling/terminal/tasks.mjs", "docs:check"],
    ["node", "tooling/terminal/tasks.mjs", "dogfood:check"],
    ["node", "tooling/terminal/tasks.mjs", "format:check"],
    ["node", "tooling/terminal/tasks.mjs", "build:packages"],
    ["node", "tooling/terminal/tasks.mjs", "lint"],
    ["node", "tooling/terminal/tasks.mjs", "typecheck"],
    ["node", "tooling/terminal/tasks.mjs", "knip"],
    ["node", "tooling/terminal/tasks.mjs", "test"],
    ["node", "tooling/terminal/tasks.mjs", "build"],
    ["node", "tooling/terminal/tasks.mjs", "size"],
    ["node", "tooling/terminal/tasks.mjs", "bible:check"]
  ],
  "check:full": [
    ["node", "tooling/terminal/tasks.mjs", "check"],
    ["node", "tooling/size/check.mjs", "--release"],
    ["node", "tooling/terminal/tasks.mjs", "storybook:build"],
    ["node", "tooling/terminal/tasks.mjs", "test:e2e"],
    ["node", "tooling/terminal/tasks.mjs", "perf:smoke"],
    ["node", "tooling/terminal/tasks.mjs", "consumer:check"]
  ],
  "check:fix": [
    ["node", "tooling/terminal/tasks.mjs", "generate"],
    ["node", "tooling/terminal/tasks.mjs", "build:packages"],
    ["node", "tooling/terminal/tasks.mjs", "lint:fix"],
    ["node", "tooling/terminal/tasks.mjs", "format"],
    ["node", "tooling/terminal/tasks.mjs", "generate"],
    ["node", "tooling/terminal/tasks.mjs", "check"]
  ],
  "changeset": [["pnpm", "exec", "changeset"]],
  "release:version": [["pnpm", "exec", "changeset", "version"]],
  "release": [["node", "tooling/release/instructions.mjs"]],
  "bible:changed": [
    ["node", "scripts/run-coding-bible.mjs", "check", ".", "--changed"]
  ],
  "size:changed": [
    ["node", "tooling/terminal/tasks.mjs", "build:packages"],
    ["node", "tooling/size/check.mjs", "--changed"],
    ["node", "tooling/terminal/tasks.mjs", "icons:size"]
  ],
  "size:compare": [["node", "tooling/size/compare.mjs"]],
  "size:baseline:review": [
    ["node", "tooling/terminal/tasks.mjs", "build:packages"],
    ["node", "tooling/size/check.mjs", "--review-bundled-baseline"]
  ],
  "size:aggregate:review": [
    ["node", "tooling/terminal/tasks.mjs", "build:packages"],
    ["node", "tooling/size/check.mjs", "--review-aggregate-baseline"]
  ],
  "size:aggregate:update": [
    ["node", "tooling/terminal/tasks.mjs", "build:packages"],
    ["node", "tooling/size/check.mjs", "--update-aggregate-baseline"]
  ],
  "size:update": [
    ["node", "tooling/terminal/tasks.mjs", "build:packages"],
    ["node", "tooling/size/check.mjs", "--update-bundled-baseline"]
  ],
  "size:release": [
    ["node", "tooling/terminal/tasks.mjs", "build:packages"],
    ["node", "tooling/size/check.mjs", "--release"],
    ["node", "tooling/terminal/tasks.mjs", "icons:size"]
  ],
  "size:test": [
    [
      "node",
      "--test",
      "--test-reporter=./tooling/terminal/node-reporter.mjs",
      "tooling/size/*.test.mjs"
    ]
  ],
  "build:packages": [
    ["pnpm", "--filter", "@flux-ui/tokens", "build"],
    ["pnpm", "--filter", "@flux-ui/icons", "build"],
    ["pnpm", "--filter", "@flux-ui/identity", "build"],
    ["pnpm", "--filter", "@flux-ui/react", "build"]
  ],
  "storybook": [["pnpm", "--filter", "@flux-ui/storybook", "dev"]],
  "storybook:build": [["pnpm", "--filter", "@flux-ui/storybook", "build"]],
  "perf": [["node", "tooling/perf/check.mjs"]],
  "perf:update": [
    ["node", "tooling/perf/check.mjs", "--update-baseline"],
    ["node", "tooling/terminal/tasks.mjs", "generate"]
  ],
  "perf:smoke": [["node", "tooling/perf/check.mjs", "--smoke"]],
  "docs:check": [["node", "scripts/check-docs.mjs"]],
  "docs:test": [
    [
      "node",
      "--test",
      "--test-reporter=./tooling/terminal/node-reporter.mjs",
      "scripts/test/docs-catalog.test.mjs",
      "scripts/test/public-contracts.test.mjs",
      "scripts/test/component-readiness.test.mjs",
      "scripts/test/showcase*.test.mjs"
    ],
    ["node", "tooling/terminal/tasks.mjs", "drift:test"]
  ],
  "icons:size": [
    ["pnpm", "--filter", "@flux-ui/icons", "build"],
    ["node", "tooling/icons/check.mjs"]
  ],
  "icons:test": [
    [
      "node",
      "--test",
      "--test-reporter=./tooling/terminal/node-reporter.mjs",
      "tooling/icons/*.test.mjs"
    ]
  ],
  "icons:size:update": [
    ["pnpm", "--filter", "@flux-ui/icons", "build"],
    ["node", "tooling/icons/check.mjs", "--update-baseline"]
  ],
  "trust:test": [
    [
      "node",
      "--test",
      "--test-reporter=./tooling/terminal/node-reporter.mjs",
      "tooling/trust/*.test.mjs",
      "tooling/release/*.test.mjs",
      "tooling/verify/*.test.mjs"
    ],
    ["node", "tooling/terminal/tasks.mjs", "terminal:test"]
  ],
  "trust:quality": [["node", "tooling/trust/run-checks.mjs", "quality"]],
  "trust:browser": [["node", "tooling/trust/run-checks.mjs", "browser"]],
  "trust:generate": [["node", "tooling/trust/generate.mjs"]],
  "release:pack": [["node", "tooling/release/pack.mjs"]],
  "dogfood:check": [["node", "tooling/dogfood/check.mjs"]],
  "dogfood:test": [
    [
      "node",
      "--test",
      "--test-reporter=./tooling/terminal/node-reporter.mjs",
      "tooling/dogfood/*.test.mjs"
    ]
  ],
  "archive": [["node", "scripts/archive.mjs"]],
  "verify:all": [["node", "scripts/verify-all.mjs"]],
  "consumer:packed": [["node", "tooling/release/packed-consumer.mjs"]],
  "consumer:check": [
    ["node", "tooling/terminal/tasks.mjs", "build:packages"],
    [
      "pnpm",
      "--filter",
      "@flux-ui/docs",
      "exec",
      "tsc",
      "-p",
      "consumer/tsconfig.json"
    ],
    [
      "pnpm",
      "--filter",
      "@flux-ui/docs",
      "exec",
      "playwright",
      "test",
      "--config",
      "consumer/playwright.config.ts"
    ]
  ],
  "safety:test": [
    [
      "node",
      "--test",
      "--test-reporter=./tooling/terminal/node-reporter.mjs",
      "tooling/safety/*.test.mjs"
    ]
  ],
  "feature:test": [
    [
      "node",
      "--test",
      "--test-reporter=./tooling/terminal/node-reporter.mjs",
      "tooling/features/*.test.mjs"
    ]
  ],
  "terminal:test": [
    [
      "node",
      "--test",
      "--test-reporter=./tooling/terminal/node-reporter.mjs",
      "tooling/terminal/*.test.mjs",
      "tooling/doctor/*.test.mjs"
    ]
  ],
  "doctor": [["node", "tooling/doctor/cli.mjs"]],
  "build:docs": [
    ["pnpm", "--filter", "@flux-ui/docs", "build"],
    ["node", "tooling/size/docs-chunks.mjs"]
  ],
  "drift:check": [["node", "tooling/drift/check.mjs"]],
  "drift:test": [
    [
      "node",
      "--test",
      "--test-reporter=./tooling/terminal/node-reporter.mjs",
      "tooling/drift/*.test.mjs"
    ]
  ]
}
