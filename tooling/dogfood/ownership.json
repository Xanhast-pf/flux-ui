        "@media (forced-colors: active) / .collection-art": ["background"],
        "@media (forced-colors: active) / .collection-art::before": [
          "border-color"
        ],
        "@supports not selector(::-webkit-scrollbar) / html, .preview-frame, .preview-stage": [
          "scrollbar-width",
          "scrollbar-color"
        ],
        "@media (forced-colors: none) / :is(html, .preview-frame, .preview-stage)::-webkit-scrollbar": [
          "width",
          "height"
        ],
        "@media (forced-colors: none) / :is(html, .preview-frame, .preview-stage)::-webkit-scrollbar-track": [
          "background"
        ],
        "@media (forced-colors: none) / :is(html, .preview-frame, .preview-stage)::-webkit-scrollbar-thumb": [
          "border",
          "background",
          "background-clip",
          "border-radius"
        ],
        "@media (forced-colors: none) / :is(html, .preview-frame, .preview-stage)::-webkit-scrollbar-thumb:hover": [
          "background-color"
        ],
        "@media (forced-colors: active) / html, .preview-frame, .preview-stage": [
          "scrollbar-color",
          "scrollbar-width"
        ]
      }
    }
